# Copy to .env and adjust. Every value below already has this same default in
# config.py, so .env is only needed to override something.

# --- Ollama (local inference — no cloud LLM provider) ---
OLLAMA_BASE_URL=http://localhost:11434
# Generic placeholder — point at whatever chat model you have pulled in
# Ollama, or override per-run with `--model` (run_eval.py) / `--model` (bench_ollama.py).
OLLAMA_CHAT_MODEL=my-finetuned-model
OLLAMA_EMBED_MODEL=nomic-embed-text
# Near-greedy decoding: an eval should be as reproducible as the engine allows.
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
RAG_CONTEXT_RESERVE_TOKENS=512
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_BENCH_URL=http://localhost:11434
# Ollama HOST tuning flags: recorded in the run manifest for provenance only.
# Export them before `ollama serve`; the harness does not set them.
OLLAMA_FLASH_ATTENTION=
OLLAMA_KV_CACHE_TYPE=
OLLAMA_NUM_PARALLEL=

# --- Postgres + pgvector (wherever your ingested chunks live) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=raguser
DATABASE_PASSWORD=ragpassword
DATABASE_NAME=rag_eval
DATABASE_SSLMODE=prefer
DATABASE_CONNECT_TIMEOUT=10
# Server-side statement_timeout (ms): a stalled vector scan fails loud, not hangs.
DATABASE_STATEMENT_TIMEOUT_MS=30000

# --- Retrieval / reranking ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_MODEL=BAAI/bge-reranker-base
# Pin to a Hugging Face commit SHA before treating comparisons as citable
# (blank = unpinned; the harness warns).
RERANK_MODEL_REVISION=
RERANK_DEVICE=cpu
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=8
PGVECTOR_DISTANCE_STRATEGY=cosine
PGVECTOR_COLLECTION_NAME=rag_documents
# Chars-per-token estimate for the context budget (Ollama tokenization is model-specific).
CHARS_PER_TOKEN_ESTIMATE=4
CORPUS_REVISION=unversioned

# --- MLflow (experiment tracking) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rag-eval-harness
MLFLOW_BENCH_EXPERIMENT_NAME=rag-eval-harness-bench
# Scorecards contain verbatim questions/answers. A non-local tracking URI needs
# https AND this explicit opt-in; loopback / file: / sqlite: stores always work.
MLFLOW_ALLOW_REMOTE=false

# full stores questions/answers; redacted stores hashes instead.
RESULT_CONTENT_MODE=full

# --- Harness internals ---
# Wall-clock bound (s) for best-effort host probes (git, nvidia-smi).
HOST_PROBE_TIMEOUT=2
# compare_runs.py ignores per-question latency deltas below this (seconds).
COMPARE_LATENCY_NOISE_S=0.5
