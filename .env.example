# Copy to .env and adjust. Every value below already has this same default in
# config.py, so .env is only needed to override something.

# --- Ollama (local inference — no cloud LLM provider) ---
OLLAMA_BASE_URL=http://localhost:11434
# Generic placeholder — point at whatever chat model you have pulled in
# Ollama, or override per-run with `--model` (run_eval.py) / `--model` (bench_ollama.py).
OLLAMA_CHAT_MODEL=my-finetuned-model
OLLAMA_EMBED_MODEL=nomic-embed-text
# Near-greedy decoding: an eval should be as reproducible as the engine allows.
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_BENCH_URL=http://localhost:11434

# --- Postgres + pgvector (wherever your ingested chunks live) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=raguser
DATABASE_PASSWORD=ragpassword
DATABASE_NAME=rag_eval

# --- Retrieval / reranking ---
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_MODEL=BAAI/bge-reranker-base

# --- MLflow (experiment tracking) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rag-eval-harness
MLFLOW_BENCH_EXPERIMENT_NAME=rag-eval-harness-bench
